# MOCHI - Masail Online & Comprehensive Heritage Intelligence
# Environment Variables Template
# Salin file ini sebagai .env.local dan isi nilainya
# JANGAN commit .env.local ke Git (.gitignore sudah mengecualikannya)

# ==========================================================
# SUPABASE (Database, Auth, Storage)
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================================
# AI LAYER: EMBEDDING (Google AI Studio - text-embedding-004)
# ==========================================================
# Dapatkan API key di https://aistudio.google.com/ (Gratis, tanpa kartu kredit)
GOOGLE_AI_API_KEY=AIzaSy_your_gemini_api_key_here
AI_EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=text-embedding-004
AI_EMBEDDING_DIMENSION=768

# ==========================================================
# AI LAYER: CHATBOT RAG (Groq - Llama 3.3 70B)
# ==========================================================
# Dapatkan API key di https://console.groq.com/ (Gratis, LPU super cepat)
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_CHAT_PROVIDER=groq
AI_CHAT_MODEL=llama-3.3-70b-versatile

# Fallback LLM jika kuota Groq sedang padat (otomatis memakai Google AI)
AI_FALLBACK_CHAT_MODEL=gemini-1.5-flash

# ==========================================================
# KEAMANAN & SESI
# ==========================================================
# Salt acak untuk hashing sesi tayangan (min 32 karakter)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESI_SALT=ganti-ini-dengan-string-acak-minimal-32-karakter-panjang

# ==========================================================
# KONFIGURASI SITUS
# ==========================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# ==========================================================
# EMAIL NOTIFIKASI (Resend API)
# ==========================================================
# Dapatkan API key di https://resend.com/ (Gratis 3000 email/bln)
# Jika tidak diisi, sistem otomatis beralih ke simulasi log tanpa error
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=admin@mochi.pesantren.id
EMAIL_FROM=MOCHI <onboarding@resend.dev>

